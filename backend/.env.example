# ---------------------------------------------------------------------------
# Copy to .env and edit. .env is gitignored and must never be committed.
#
# Values shown are development defaults. Everything marked PRODUCTION must be
# changed before deploying — app/core/config.py:assert_production_safe() refuses
# to start the API if any of them are still development values.
# ---------------------------------------------------------------------------

# --- database --------------------------------------------------------------
# The driver must be named explicitly: psycopg2 is not a dependency.
DATABASE_URL=postgresql+psycopg://pgdesk:pgdesk@localhost:5432/pgdesk
TEST_DATABASE_URL=postgresql+psycopg://pgdesk:pgdesk@localhost:5432/pgdesk_test

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- security --------------------------------------------------------------
# PRODUCTION: generate a real secret. Anything containing "change-me", or
# shorter than 32 characters, is refused at startup.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-generate-a-real-secret-before-any-deployment

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- refresh session cookie ------------------------------------------------
# The refresh token is delivered as an HttpOnly cookie so injected script cannot
# read it. The access token stays in the response body and is held in memory by
# the browser client.
REFRESH_COOKIE_NAME=pgdesk_refresh
# Scoped to the auth path so the cookie is not attached to every other request.
REFRESH_COOKIE_PATH=/api/v1/auth

# PRODUCTION: must be true. Set false only for local http development, where a
# Secure cookie would never be sent at all.
REFRESH_COOKIE_SECURE=false

# "lax" when the front end and API share a site. Use "none" when they are on
# different sites (which then also requires REFRESH_COOKIE_SECURE=true and
# HTTPS on both).
REFRESH_COOKIE_SAMESITE=lax
# Leave unset unless you are sharing the cookie across subdomains.
# REFRESH_COOKIE_DOMAIN=.example.com

# PRODUCTION: must be false. Returns the refresh token in the JSON body as well
# as the cookie, for non-browser clients with no cookie jar. A body value is
# readable by anything that can hook fetch, which defeats the HttpOnly cookie.
EXPOSE_REFRESH_TOKEN_IN_BODY=false

# --- cors ------------------------------------------------------------------
# Comma-separated exact origins. PRODUCTION: never "*" — credentials are sent
# with every request, so a wildcard would let any site drive the API as the user.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- android (Capacitor) ---------------------------------------------------
# The Android app is the same React bundle inside a WebView served from
# https://localhost, so every API call is CROSS-SITE. Three things follow, and
# all three are required or the session silently dies ~30 minutes after login:
#
#   1. CORS_ORIGINS must include  https://localhost
#   2. REFRESH_COOKIE_SAMESITE=none   (a "lax" cookie is not sent cross-site)
#   3. REFRESH_COOKIE_SECURE=true     (mandatory whenever SameSite=none)
#
# (3) means the API must be reachable over HTTPS - the app refuses to build
# against an http origin for exactly this reason.
#
# Example production values when serving an Android build:
#   CORS_ORIGINS=https://app.pgdesk.example.com,https://localhost
#   REFRESH_COOKIE_SAMESITE=none
#   REFRESH_COOKIE_SECURE=true
#
# See frontend/ANDROID.md -> "Session and cookies on Android".

# --- application -----------------------------------------------------------
ENVIRONMENT=development
# PRODUCTION: must be false. Debug responses can carry internal detail.
DEBUG=true
PROJECT_NAME=PGDesk API
API_V1_PREFIX=/api/v1

# --- development seed ------------------------------------------------------
# Password shared by the accounts `python seed.py` creates. Development only:
# seed.py refuses to run when ENVIRONMENT=production.
DEMO_PASSWORD=demo1234

# --- notification providers (optional) -------------------------------------
# Not required to run. The master settings screen reports each channel as
# "configured" or "not configured" based on whether these are present, and the
# application never claims to have sent a message through a channel that is not.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMS_PROVIDER_KEY=
# WHATSAPP_PROVIDER_KEY=
# WHATSAPP_PHONE_ID=
