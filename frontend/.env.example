# ---------------------------------------------------------------------------
# Copy to .env.local for development. .env.local is gitignored.
# Vite only exposes variables prefixed VITE_, and they are embedded into the
# built bundle — never put a secret in this file.
# ---------------------------------------------------------------------------

# Where the API lives. Required in every environment.
VITE_API_URL=http://localhost:8000/api/v1

# Shows the accounts created by backend/seed.py on the sign-in screen as
# one-click logins, with their passwords filled in.
#
# NEVER set this in production. These are working credentials; exposing them
# hands a valid session to anyone who loads the login page. Unset, or any value
# other than "true", leaves them out of the bundle entirely — verified by
# grepping the production build.
VITE_SHOW_SEED_ACCOUNTS=true
