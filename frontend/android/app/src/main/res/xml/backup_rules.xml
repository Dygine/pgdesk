<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 (API 30) and earlier, where android:fullBackupContent is what
    gets read. minSdk is 24, so these versions are still in range.

    allowBackup="false" in the manifest already stops backup on these versions;
    this file is the belt to that pair of braces. If someone later flips
    allowBackup back to true to debug something and forgets, the exclusions
    below still hold.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
