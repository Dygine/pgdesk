<?xml version="1.0" encoding="utf-8"?>
<!--
  The small icon in the status bar.

  Android masks this to a silhouette: every non-transparent pixel is repainted
  white (or the accent colour on some builds) and everything else is dropped. A
  full-colour app icon used here therefore renders as a solid grey square, which
  is the single most common visual bug in a first push release.

  A vector rather than five PNGs: it is one file, scales to every density, and
  cannot drift out of step with itself.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,22c1.1,0 2,-0.9 2,-2h-4c0,1.1 0.9,2 2,2zM18,16v-5c0,-3.07 -1.64,-5.64 -4.5,-6.32V4c0,-0.83 -0.67,-1.5 -1.5,-1.5s-1.5,0.67 -1.5,1.5v0.68C7.63,5.36 6,7.92 6,11v5l-2,2v1h16v-1l-2,-2z" />
</vector>
