{
  "appId": "in.kredo.pgguru",
  "appName": "PGuru",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "server": {
    "url": "https://pgguru.in",
    "errorPath": "offline.html",
    "cleartext": false
  },
  "plugins": {
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#0F172A",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  }
}
