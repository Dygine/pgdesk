{
  "appId": "in.kredo.pgdesk",
  "appName": "PGDesk",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#0F172A",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "resetWhenUpdate": true,
      "appReadyTimeout": 10000,
      "directUpdate": false
    }
  }
}
