{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PGDesk: Start All",
      "detail": "Backend + Frontend + browser. This is the one you want.",
      "dependsOrder": "parallel",
      "dependsOn": [
        "pgdesk:backend",
        "pgdesk:frontend",
        "pgdesk:open-browser"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },

    {
      "label": "PGDesk: First-time Setup",
      "detail": "venv, pip install, .env, CORS patch, migrations, seed, npm install. Run once per machine.",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/setup.ps1\"",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },

    {
      "label": "PGDesk: Stop All",
      "detail": "Frees ports 8000 and 5173 after a crash.",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/stop.ps1\"",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },

    {
      "label": "PGDesk: Reseed Database",
      "detail": "alembic upgrade head, then seed.py --reset",
      "type": "shell",
      "command": "& .\\.venv\\Scripts\\python.exe -m alembic upgrade head; & .\\.venv\\Scripts\\python.exe seed.py --reset",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },

    {
      "label": "PGDesk: Backend Tests",
      "detail": "The full pytest suite (needs the pgdesk_test database).",
      "type": "shell",
      "command": "& .\\.venv\\Scripts\\python.exe -m pytest",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },

    {
      "label": "PGDesk: Frontend Build",
      "detail": "vite build - doubles as the import/static check.",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },

    {
      "label": "pgdesk:backend",
      "hide": true,
      "type": "shell",
      "command": "& .\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "pgdesk",
        "clear": true,
        "focus": false
      },
      "problemMatcher": []
    },

    {
      "label": "pgdesk:frontend",
      "hide": true,
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "pgdesk",
        "clear": true,
        "focus": false
      },
      "problemMatcher": []
    },

    {
      "label": "pgdesk:open-browser",
      "hide": true,
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/open-when-ready.ps1\"",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "pgdesk",
        "clear": true,
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
